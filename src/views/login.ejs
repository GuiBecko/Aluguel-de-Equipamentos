<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Login</title>
        <link rel="stylesheet" href="/assets/css/form.css">
        <link rel="stylesheet" href="/assets/css/style.css">
    </head>
    <body>
        <div class="login">
            <div class="messages">
                <%- include('includes/messages') %>
            </div>
            <h1>Bem-vindo!</h1>
            <br>
            <form  method="POST" action="/login/login" class="form">
                <input type="hidden" name="_csrf" value=<%= csrfToken %>>
                
                <div  class="form-group">
                    <p>Email</p>
                    <input placeholder="Insira seu email" type="email" name="email">
                </div>
                
                <div class="form-group">
                    <p>Senha</p>
                    <input placeholder="Insira sua senha" type="password" name="password">
                </div>
                <div class="links">
                    <button type="submit" class="btn">Entrar</button>
                    <p>Nao tem uma conta?    <a href="/register/index">Cadastre-se</a></p>
                </div>
            </form>
        </div>

        <div class="secao"></div>
</body>
</html>