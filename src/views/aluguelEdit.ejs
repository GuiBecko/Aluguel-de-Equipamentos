<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar aluguel</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/header.css">
    <link rel="stylesheet" href="/assets/css/form.css">
</head>
<body>
    <c-header class="header" logado="<%= user ? 'true' : 'false' %>"></c-header>
    
    <div class="messages">
        <%- include('includes/messages') %>
    </div>

    <h1>Editar registro</h1>

    <div class="form-container">
        <form action="/aluguel/edit/<%= aluguel._id %>" method="post">
            <input type="hidden" name="_csrf" value=<%= csrfToken %>>
            <div  class="form-group">
                <label>Comprador</label>
                <input type="text" name="comprador" value="<%= aluguel.comprador%>">
            </div>
            
            <div  class="form-group">
                <label>Endereco</label>
                <input type="text" name="endereco" value="<%= aluguel.endereco%>">
            </div>
            
            <div  class="form-group">
                <label>Tipo do equipamento</label>
                <input type="text" name="tipoEquipamento" value="<%= aluguel.tipoEquipamento%>">
            </div>
            
            <div  class="form-group">
                <label>Valor</label>
                <input type="number" name="valor" value="<%= aluguel.valor%>">
            </div>
            
            <div  class="form-group">
                <label>Data de Aluguel</label>
                <input type="date" name="dataAluguel" value="<%= aluguel.dataAluguel ? aluguel.dataAluguel.toISOString().split('T')[0] : '' %>">
            </div>
            
            <div  class="form-group">
                <label>Termino do Aluguel</label>
                <input type="date" name="terminoAluguel" value="<%= aluguel.terminoAluguel ? aluguel.terminoAluguel.toISOString().split('T')[0] : '' %>">
            </div>
            
            <div  class="form-group">
                <label>Forma de pagamento</label>
                <input type="text" name="formaPagamento"value="<%= aluguel.formaPagamento%>">
            </div>
            
            <button type="submit">Editar</button>
        </form>
    </div>
<script src="/assets/js/header.js"></script>
</body>
</html>