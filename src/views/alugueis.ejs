<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alugueis</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/header.css">
</head>
<body>
    <c-header class="header" logado="<%= user ? 'true' : 'false' %>"></c-header>

    <h1>Meus alugueis</h1>

    <div class="input-container">
        <form method="get" class="search-form"> <!-- action="aluguel/:filtro/:valor" -->
            <input placeholder="Procurar por alugueis" type="text" name="text" class="input">
            <button type="submit" class="search-icon"></button>

            <div class="radios">
                <p>Buscar por: </p>
                <input name="filtro" type="radio" id="comprador">
                <label for="comprador">Nome do comprador</label>
                <input name="filtro" type="radio" id="terminoAluguel">
                <label for="terminoAluguel">Data de Vencimento: mm-dd-aaaa</label>
            </div>
        </form>
    </div>
    
    <%- include('includes/messages') %>

    <form method="get" action="/aluguel/register">
        <button>novo registro</button>
    </form>

    
    <div class="alugueis-table">
        
            <div class="grid-header">
                <div>Comprador</div>
                <div>Equipamento</div>
                <div>Valor</div>
                <div style="text-align: center;">Ações</div>
            </div>
            <% alugueis.forEach(aluguel => { %>
                <div class="aluguel">
                        <div style="font-size: var(--spacing3); font-family: sans-serif;"><%= aluguel.comprador %> </div>
                        <div style="font-family: sans-serif;"><%= aluguel.tipoEquipamento %> </div>
                        <div style="font-family: sans-serif;"><%= aluguel.valor %> </div>
                    
                    <div class="links">
                        <div style="cursor: pointer;" class="more-infos"><a href="/aluguel/index/<%= aluguel._id %>">mais</a></div>
                        <div> <a href="/aluguel/edit/<%= aluguel._id %>">Editar</a></div>
                        <div> <a href="/aluguel/delete/<%= aluguel._id %>">Excluir</a></div>
                    </div>
                </div>
            <% }) %>
        </div>
        
    <script src="/assets/js/buscar.js"></script>
    <script src="/assets/js/header.js"></script>
</body>
</html>