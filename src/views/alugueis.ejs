<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alugueis</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/header.css">
</head>
<body>
    <c-header class="header" logado="<%= user ? 'true' : 'false' %>"></c-header>

    <h1>Meus alugueis</h1>
    <form method="get" action="/aluguel/register">
        <button>novo registro</button>
    </form>

    
    <div class="alugueis-table">
        
            <div class="grid-header">
                <div>Comprador</div>
                <div>Equipamento</div>
                <div>Valor</div>
                <div style="text-align: center;">Ações</div>
            </div>
            <% alugueis.forEach(aluguel => { %>
                <div class="aluguel">
                        <div style="font-size: var(--spacing4);"><%= aluguel.comprador %> </div>
                        <div><%= aluguel.tipoEquipamento %> </div>
                        <div><%= aluguel.valor %> </div>
                    
                    <div class="links">
                        <div style="cursor: pointer;" class="more-infos">mais</div>
                        <div> <a href="/aluguel/index/:id">Editar</a></div>
                        <div> <a href="/aluguel/delete/:id">Excluir</a></div>
                    </div>
                </div>
            <% }) %>
        </div>

    <script src="/assets/js/header.js"></script>
    <script src="/assets/js/more-infos.js"></script>
</body>
</html>