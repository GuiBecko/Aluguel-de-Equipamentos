<% if (errors.length > 0) { %>

<div class="erro-container">
    <% errors.forEach(erro =>{ %>
        <%= erro %> <br>
    <% }) %>
</div>

<% } %>

<% if (success.length > 0) { %>

<div class="sucesso-container">
    <% success.forEach(erro =>{ %>
        <%= erro %> <br>
    <% }) %>
</div>

<% } %>